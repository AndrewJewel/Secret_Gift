rules_version = '2';

// Regalo Sorpresa (Amigo Secreto / Santa Secreto) — reglas de acceso.
//
// grupos/{codigo}: ocasion + valorMinimo + fecha. Lectura de UN documento
// concreto abierta (hace falta para "unirse con un código"); escritura
// SIEMPRE a través de las Cloud Functions (Admin SDK, ignoran estas
// reglas), nunca directo desde el cliente.
//
// ⚠️ `allow read` son DOS permisos: `get` (un documento) y `list` (la
// colección). Con `read: if true` —y sin Firebase Auth, así que "true" es
// literalmente cualquiera en internet— la colección entera era
// descargable sin credenciales: se obtenían todos los códigos, y con ellos
// los nombres reales, los avatares y los chats de todos los grupos.
// Verificado contra producción el 2026-08-09 con un GET sin token.
//
// Por eso van separados. El cliente NUNCA lista esta colección: sus cinco
// accesos son `.doc(codigo)` (pantalla_raiz, pantalla_registro,
// pantalla_unirse_grupo y pantalla_chat), así que cerrar `list` no le
// quita nada. El código del grupo vuelve a ser lo que debía ser: la única
// llave para llegar a él.
//
// grupos/{codigo}/privado/data: las máscaras ya repartidas en el chat, y el
// mapa `reemplazos` (token de un solo uso → id de la plaza que canjea). Es
// justo por eso que este documento tiene que seguir a cero para el
// cliente: un token de reemplazo es una llave, y dejarlo leer desde aquí
// sería repartir llaves sin pasar por `canjearReemplazo`.
// Cero acceso de cliente en cualquier dirección. El PIN maestro que vivía
// aquí desapareció: ser organizador lo dice tu cuenta.
//
// grupos/{codigo}/participantes/{id}: nombre + fecha + tieneAmigo (bandera
// pública, sin revelar a quién). Lectura pública, escritura solo por
// Cloud Functions.
//
// grupos/{codigo}/participantes/{id}/privado/data: de qué cuenta es esta
// plaza, la lista de deseos, a quién le regala (`asignado_a`), quién le
// regala a ella (`recibe_de`) y su máscara del chat. Cero acceso de
// cliente. El PIN del participante que vivía aquí desapareció.
//
// usuarios/{uid}: el perfil de una cuenta de Firebase Auth (nombre,
// apellido, correo, hash bcrypt del PIN de 4 dígitos, y el mapa de grupos
// vinculados). Cada quien lee SOLO el suyo; escribe solo el Admin SDK
// desde las Cloud Functions. La contraseña ya no está aquí ni en ninguna
// parte nuestra: la guarda Firebase Auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /grupos/{codigo} {
      // `get` sí, `list` no: ver la nota de arriba.
      allow get: if true;
      allow list: if false;
      allow write: if false;

      match /privado/{doc} {
        allow read, write: if false;
      }

      // Chat grupal anónimo. Cada mensaje lleva SOLO el número de
      // máscara, nunca el id de quien lo escribió: la relación
      // máscara↔persona vive en participantes/{id}/privado/data, que
      // está cerrado a cero. Lectura pública (el chat es del grupo),
      // escritura solo por Cloud Function previa verificación del PIN.
      match /chat/{mensaje} {
        allow read: if true;
        allow write: if false;
      }

      match /participantes/{id} {
        allow read: if true;
        allow write: if false;

        match /privado/{doc} {
          allow read, write: if false;
        }
      }
    }

    match /usuarios/{uid} {
      // Primera regla de esta app que puede decir "tú". La escritura sigue
      // cerrada: el pinHash y el mapa `grupos` los toca solo el Admin SDK.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
